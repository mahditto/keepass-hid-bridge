				<Action>
					<TypeGuid>lYGPRZlmSYirPoboGpZoNg==</TypeGuid>   <!-- Add custom toolbar button -->
					<Parameters>
						<Parameter>bridge_login</Parameter>
						<Parameter>Type login</Parameter>
